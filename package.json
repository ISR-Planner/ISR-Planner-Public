{
  "name": "isr-planner-infrastructure-checks",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:infra": "npm run test:infra:unit && npm run test:infra:browser",
    "test:infra:unit": "node --test tests/infrastructure/*.test.cjs",
    "test:infra:browser": "playwright test --config tests/infrastructure/playwright.config.mjs",
    "install:browser": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "leaflet": "1.9.4"
  }
}
