# ISR Mission Planner - Environment Variables
# Copy this file to .env and fill in your values

# ============ LLM Provider API Keys ============
# At least one of these must be set. The active provider is selected
# in the UI Settings panel (or via LLM_PROVIDER below); whichever key
# matches the chosen provider gets used.

# OpenAI API key (default hosted provider — gpt-4o, o1, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key (optional, for Claude models if you add/use an Anthropic provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Z.AI API key (optional, for GLM models — glm-4.6, glm-4.5-flash, etc.)
# OpenAI-compatible endpoint at https://api.z.ai/api/paas/v4
# Get a key at https://z.ai
ZAI_API_KEY=your_zai_api_key_here

# Google API key (optional, for Gemini models — gemini-1.5-pro, etc.)
GOOGLE_API_KEY=your_google_api_key_here

# Groq API key (optional, for fast open-source models — Llama 3.3, Mixtral, etc.)
GROQ_API_KEY=your_groq_api_key_here

# Ollama (optional) — run local open-source models with NO API key.
# Install Ollama (https://ollama.com), then `ollama pull llama3.1` (or qwen2.5,
# mistral, etc.). The planner talks to Ollama's OpenAI-compatible endpoint.
# Only override this if Ollama runs on a non-default host/port.
OLLAMA_BASE_URL=http://localhost:11434

# ============ Text-to-Speech (agent voice replies) ============
# Optional. Kokoro (local neural) and the browser voice work with NO key.
# Set this to also offer the "ElevenLabs (cloud)" option in the voice dropdown.
# Cloud synthesis means no browser main-thread stalls. Get a key at
# https://elevenlabs.io (Profile -> API Keys).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional overrides. Voice defaults to "Rachel"; model to the low-latency
# eleven_turbo_v2_5. Find voice IDs in your ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# ============ Cesium Ion (3D globe view) ============
# Optional. Powers the "3D" mission view (real satellite imagery + terrain).
# Without it, the 3D view still works but falls back to Cesium's bundled
# offline low-res imagery and flat terrain. Get a free token at
# https://ion.cesium.com (Access Tokens tab, copy the Default Token).
CESIUM_ION_TOKEN=your_cesium_ion_token_here

# ============ Supabase Configuration ============
# Get these from your Supabase project dashboard
# Project Settings -> API

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (safe for client-side)
# Or use the service_role key for server-side operations
SUPABASE_KEY=your_supabase_key_here

# ============ Application Settings ============
# Server port (Railway sets this automatically)
PORT=8893

# Python path for imports
PYTHONPATH=/app

# ============ Optional Settings ============
# Default LLM provider when no provider is specified in code/UI
# (openai | zai | google | groq | ollama)
LLM_PROVIDER=openai

# Default model to use (must match the chosen provider)
LLM_MODEL=gpt-4o

# Legacy name for the default model (kept for backwards compatibility)
DEFAULT_MODEL=gpt-4o

# Debug mode (set to "true" for development)
DEBUG=false
