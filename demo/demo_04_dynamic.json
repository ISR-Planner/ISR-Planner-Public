  "name": "Demo 4: Dynamic Mission Replanning",
  "description": "Scenario designed for cut/edit/replan demonstration",
  "dynamic_demo_instructions": {
    "step1": "Solve and start animation",
    "step2": "Let drones travel about 30-40% of their routes",
    "step3": "Click Edit while animating",
    "step4_option_a": "Add a new SAM at approximately (37.71, -122.15) to block a drone's path",
    "step4_option_b": "Remove T4 or T5 (simulating target no longer relevant)",
    "step4_option_c": "Add a new high-priority target at (37.69, -122.22)",
    "step5": "End Edit - observe white diamond (cut point) and new solution",
    "step6": "Continue animation to show new routes",
    "step7": "Optionally make another cut to show multi-segment mission"
  },
